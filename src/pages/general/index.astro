---
import Base from '../../layouts/Base.astro';
import SiteHeader from '../../components/SiteHeader.astro';
import SiteFooter from '../../components/SiteFooter.astro';
---

<Base title="General — Kuraness" description="General: proyectos e ideas de Kuraness.">
  <SiteHeader current="General" />
  <main class="inner-main">
    <section class="page-intro">
      <p class="eyebrow">02 / Un punto de partida</p>
      <h1>General<span class="gold-dot">.</span></h1>
      <p class="lead">Un espacio para reunir proyectos, imágenes e ideas. Esta página irá creciendo con el tiempo.</p>
    </section>
    <section class="projects-section" aria-labelledby="projects-title">
      <div class="section-heading"><h2 id="projects-title">Proyectos</h2><span>01 / 01</span></div>
      <a class="project-card" href="/general/liminal/">
        <div class="project-image" role="img" aria-label="Espacio de aspecto liminal"></div>
        <div class="project-info">
          <span class="eyebrow">Proyecto 01</span>
          <div class="project-title-row"><h3>Liminal</h3><span aria-hidden="true">↗</span></div>
          <p>Una colección visual de lugares entre lo familiar y lo extraño.</p>
          <span class="text-link">Explorar proyecto <span aria-hidden="true">→</span></span>
        </div>
      </a>
    </section>
  </main>
  <SiteFooter right="Más por venir" />
</Base>
